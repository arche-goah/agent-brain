#!/usr/bin/env bash
# pre-commit — checks where a defect is born instead of at the end of the chain.
#
# WHY (measured 2026-08-08 on the proving brain): leak-scan and suite-check ran only in CI, i.e.
# on push. A push of 16 collected commits found two hits that had sat in the tree for several
# commits — without the chance push they would have stayed. A checker at the end of the chain says
# nothing about the state in between. Ported from that brain's instance hook into the core so every
# brain runs the same checks (2026-10-18).
#
# GLOBAL (core.hooksPath), so it behaves in EVERY repo: what a repo does not ship is not checked —
# no failure, no noise. Emergency bypass: git commit --no-verify (deliberately possible; a hook that
# cannot be bypassed gets switched off globally at the first conflict and then protects nothing).
set -u
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
core=$(cd "$here/../.." && pwd)
brain=$(cd "$core/.." && pwd)
py=python3; "$py" -c 'import sys' >/dev/null 2>&1 || py=python   # Windows: python3 can be the Store stub (OS-17)
fail=0

run_check() {   # run_check <label> <command...>
  local label=$1; shift
  local out
  if ! out=$("$@" 2>&1); then
    echo ""
    echo "pre-commit: $label BLOCKS the commit"
    echo "$out" | tail -25
    fail=1
  fi
}

# 1. Instance data in a tool repo: only where the repo ships its own scanner (core, suites). The
#    brain's watch list goes along for the names; without one the generic classes still apply.
if [ -f "$root/scripts/leak-scan.py" ]; then
  if [ -f "$brain/.claude/rules/leak-names.json" ] && [ "$root" != "$brain" ]; then
    LEAK_NAMES_JSON="$(cat "$brain/.claude/rules/leak-names.json")" run_check "leak-scan" "$py" "$root/scripts/leak-scan.py"
  else
    run_check "leak-scan" "$py" "$root/scripts/leak-scan.py"
  fi
fi

# 2. Suite contract against the core: only where a dependency manifest lies.
if [ -f "$root/dependencies.json" ] && [ -f "$core/scripts/suite-check.py" ]; then
  run_check "suite-check" "$py" "$core/scripts/suite-check.py" "$root"
fi

# 3. A repo's own hardcode lint (show network parameters never hardcoded) — where it ships one.
if [ -f "$root/scripts/hardcode-lint.py" ]; then
  run_check "hardcode-lint" "$py" "$root/scripts/hardcode-lint.py"
fi

# 4. shared-memory: entry rules bite when writing, not at the weekly scan (`--staged` judges only
#    what the commit adds). A shared-memory repo carries parties.json at its root.
if [ -f "$root/parties.json" ] && [ -f "$core/scripts/shared-memory-lint.py" ]; then
  run_check "shared-memory-lint" "$py" "$core/scripts/shared-memory-lint.py" --repo "$root" --staged
fi

# 4b. Lessons bind or they are not written (operator, 2026-10-26: "a rule entered in the feedback amounts
#     to an empty promise in the long run"). A brain whose feedback protocol is configured
#     (.claude/rules/lesson-carriers.json) cannot commit a NEW protocol entry whose carrier is prose, a
#     report or nothing — only a wired gate, a data row such a gate reads, a mechanism-rules id, a CI step,
#     a PR reference (pending), or the operator's quoted ok. Old entries never block here; the
#     brain-scan reports them (scripts/carrier-audit.py, report mode).
if [ -f "$root/.claude/rules/lesson-carriers.json" ] && [ -f "$core/scripts/carrier-audit.py" ]; then
  run_check "carrier-audit" "$py" "$core/scripts/carrier-audit.py" --repo "$root" --core "$core" --staged
fi

# 4c. A new dated rule: which OLD places say something about the same thing? (rule-conflict protocol step 2,
#     `rules/thinking-protocol.md`). REPORT ONLY, never blocks: judging an old place takes a look, not a gate.
#     Until 2026-11-02 backprop-report.py had no caller but a prose pointer (audit of the audits, package G);
#     the moment a rule file is committed is the moment its old places are still in mind.
rules_staged=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null \
  | grep -E '^(rules/[^/]+\.md|\.claude/rules/[^/]+\.md|templates/feedback\.md|templates/rules-instance/[^/]+\.md)$')
if [ -n "$rules_staged" ] && [ -f "$core/scripts/backprop-report.py" ]; then
  if [ -d "$root/rules" ] && [ -f "$root/scripts/backprop-report.py" ]; then
    # the core repo itself: its rule and skill trees are the old places
    # shellcheck disable=SC2086
    bp=$("$py" "$core/scripts/backprop-report.py" --root "$root" --search rules --search skills --search docs --search templates -- $rules_staged 2>/dev/null)
  else
    # shellcheck disable=SC2086
    bp=$("$py" "$core/scripts/backprop-report.py" --root "$root" -- $rules_staged 2>/dev/null)
  fi
  if printf '%s' "$bp" | grep -q 'places=[1-9]'; then
    echo "pre-commit: report (does not block) — older places that name terms of the new dated rule; mark what it supersedes:" >&2
    printf '%s\n' "$bp" | head -40 >&2
  fi
fi

# 5. Behind the upstream (operator order 2026-10-22, agreed by both core parties): a commit on a
#    checkout that another machine pushed past lands on an old state, and its push is refused
#    afterwards (measured 2026-10-22, and twice on 2026-10-25, on Windows brains). The start pull
#    (helpers/session-pull.sh) cannot see a push that arrives after it. So: fetch, COUNT what the
#    upstream has and HEAD lacks, refuse while that is > 0 — never pull here. Fail-open: switched
#    off, no upstream, detached HEAD, a merge being concluded (it brings the upstream in), no
#    network, fetch slower than PRE_COMMIT_FETCH_TIMEOUT (default 8 s). Off for one repo:
#    git config brain.preCommitFetch false
behind_check() {
  [ "$(git config --bool brain.preCommitFetch 2>/dev/null)" = "false" ] && return 0
  git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && return 0
  local up br remote fpid ticks=0 n limit=$(( ${PRE_COMMIT_FETCH_TIMEOUT:-8} * 5 ))
  up=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || return 0
  br=$(git symbolic-ref --short HEAD 2>/dev/null) || return 0
  remote=$(git config "branch.$br.remote" 2>/dev/null)
  [ -n "$remote" ] && [ "$remote" != "." ] || return 0
  # A watched background fetch, not `timeout` (stock macOS has none, os-traps OS-16).
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true git fetch -q --no-write-fetch-head "$remote" >/dev/null 2>&1 &
  fpid=$!
  while kill -0 "$fpid" 2>/dev/null; do
    if [ "$ticks" -ge "$limit" ]; then
      kill "$fpid" 2>/dev/null
      echo "pre-commit: upstream check skipped — fetch of '$remote' took over ${PRE_COMMIT_FETCH_TIMEOUT:-8} s" >&2
      return 0
    fi
    sleep 0.2; ticks=$((ticks + 1))
  done
  if ! wait "$fpid"; then
    echo "pre-commit: upstream check skipped — fetch of '$remote' failed (offline?)" >&2
    return 0
  fi
  n=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null) || return 0
  [ "${n:-0}" -gt 0 ] 2>/dev/null || return 0
  echo ""
  echo "pre-commit: $(basename "$root") ($br) is behind $up by $n commit(s) — pushed elsewhere since this checkout was pulled:"
  git log --oneline -n 10 'HEAD..@{u}' | sed 's/^/  /'
  [ "$n" -gt 10 ] && echo "  ... and $((n - 10)) more"
  echo "Read them, then: git pull --ff-only (or merge, with local commits of your own), then commit."
  echo "Off for this repo: git config brain.preCommitFetch false"
  fail=1
}
behind_check

# 6. A NEW site of a known OS trap (operator, 2026-10-29: build it): on one instance three closed
#    traps came back in a single day and each was found only by CI on the other OS. This step never
#    reads invariant-check.py's exit code (it also reports open classes and prose-only entries); it
#    blocks only on a "NEW site" line under a [closed] trap, i.e. drift against the register's
#    baseline. Only where the repo ships the register and the checker (the core); ~0.4 s.
if [ -f "$root/docs/os-traps.md" ] && [ -f "$root/scripts/invariant-check.py" ]; then
  # only CLOSED traps: a new site of an open class is the register's normal growth, not a regression.
  # awk, not `| grep -q`: that is OS-5 itself.
  new=$("$py" "$root/scripts/invariant-check.py" "$root/docs/os-traps.md" 2>&1 \
        | awk '/^  (!!|ok|\?\?)  / { head = $0; closed = ($0 ~ /\[closed\]/) } /NEW site/ && closed { print head; print }')
  if [ -n "$new" ]; then
    echo ""
    echo "pre-commit: a closed OS trap has a NEW site (docs/os-traps.md) — fix it, or extend the register's known: baseline with the reason"
    printf '%s\n' "$new"
    fail=1
  fi
fi

# invariant-check as a whole is a report, not a gate (open classes are a register's normal state);
# step 6 reads only its drift lines under closed traps.

# Every staged .json parses (2026-10-29, measured on the macOS instance: a regex edit broke
# .claude/rules/local-machinery.json — "Invalid control character" — and the commit went through).
# Nearly every gate reads its rules from JSON and fails OPEN on an unreadable file, so a broken
# rule file switches its gate off without a sound. The STAGED content is parsed (git show :path),
# not the working copy: that is what the commit carries.
json_check() {
  local f bad=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! git show ":$f" | "$py" -c 'import json,sys; json.load(sys.stdin)' >/dev/null 2>&1; then
      bad="$bad
  $f: $(git show ":$f" | "$py" -c 'import json,sys
try: json.load(sys.stdin)
except Exception as e: print(e)' 2>&1 | head -1)"
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.json')
  [ -z "$bad" ] && return 0
  echo ""
  echo "pre-commit: staged JSON does not parse - a gate reading it would fail open:$bad"
  fail=1
}
json_check

# A changelog fragment declares its level in the form helpers/change-level.cjs reads (2026-11-03, measured on the macOS
# instance: six fragments with "higher: none" on reader/writer went in, the lint caught them minutes later, twice).
# Runs only in a repo that ships the checker and only when a fragment is staged.
if [ -f "$root/helpers/change-level.cjs" ] && command -v node >/dev/null 2>&1 \
   && [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- 'changelog.d/*.md')" ]; then
  run_check "change-level (changelog.d)" node "$root/helpers/change-level.cjs" check --root "$root"
fi

# The English-only ratchet, where the repo ships it (2026-11-03, same class as the level field: a German quote in a
# fragment reached the push lint before anything said so). Runs in ~0.3 s over the repo.
if [ -f "$root/scripts/english-only.py" ]; then
  run_check "english-only" "$py" "$root/scripts/english-only.py"
fi

# A staged data file runs the fixture that covers it (2026-11-07, measured on the macOS instance: three new guard rules
# went in without a single case and a removed rule left its cases behind; the instance's fixture said so only at the next
# session start, four commits later). A fixture in the repo's scripts/ takes part when it carries the line
# `# pre-commit: covers` (opt-in: it must run in seconds) — then it runs when a staged file's base name without its
# extension stands in its `# covers:` line (`.claude/rules/mechanism-rules.json` -> `mechanism-rules`), when the
# fixture itself is staged, and for a removed file too. Red blocks. In every repo, so an instance's fixture counts.
covers_check() {
  [ -d "$root/scripts" ] || return 0
  local staged f stems tokens t s run
  staged=$(git diff --cached --name-only --diff-filter=ACMRD)
  [ -n "$staged" ] || return 0
  stems=" "
  while IFS= read -r f; do s=${f##*/}; stems="$stems${s%.*} "; done <<< "$staged"
  # JS fixtures (test-*.cjs / test-*.js) take part the same way with `//` comments (reach finding at #453, 2026-11-07:
  # the gate fixtures are .cjs and stayed out of reach).
  for f in "$root"/scripts/test-*.sh "$root"/scripts/*-test.py "$root"/scripts/test-*.cjs "$root"/scripts/test-*.js; do
    [ -f "$f" ] && grep -qE '^(#|//) pre-commit: covers' "$f" || continue
    run=0
    case "$stems" in *" $(basename "${f%.*}") "*) run=1 ;; esac
    tokens=$(sed -nE 's,^(#|//) covers:[[:space:]]*,,p' "$f" | head -1 | sed 's/(.*//')
    for t in $tokens; do case "$stems" in *" $t "*) run=1 ;; esac; done
    [ "$run" -eq 1 ] || continue
    case "$f" in
      *.cjs|*.js) run_check "fixture ${f#"$root"/}" bash -c 'cd "$1" && node "$2"' _ "$root" "$f" ;;
      *.py) run_check "fixture ${f#"$root"/}" bash -c 'cd "$1" && "$2" "$3"' _ "$root" "$py" "$f" ;;
      *)    run_check "fixture ${f#"$root"/}" bash -c 'cd "$1" && bash "$2"' _ "$root" "$f" ;;
    esac
  done
}
covers_check

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Nothing was committed. Fix it — or, with a reason: git commit --no-verify"
  exit 1
fi
exit 0
