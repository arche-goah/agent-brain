{
  "_comment": "From agent-brain/templates. Hooks point at core/helpers (submodule). Marketplace/plugins: enter once, installation happens on the next start. The marketplace below is an EXAMPLE — replace 'your-org' with the marketplace repo that pins this core for your setup.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/file-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/mechanism-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/shared-working-copy-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/secret-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/freshness-gate.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/public-text-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/instance-key-gate.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/live-read-gate.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/skill-gate.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/conditional-order-gate.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/junk-cleaner.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/notify.cjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/core/helpers/session-pull.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/core/helpers/session-bootup.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/memory-sync.cjs\" import",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/core/helpers/session-closing.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/memory-sync.cjs\" export",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/stop-dispatcher.cjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/memory-sync.cjs\" export",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/core/helpers/notify.cjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "your-org": {
      "source": {
        "source": "github",
        "repo": "your-org/claude-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "brain-core@your-org": true
  },
  "permissions": {
    "_comment": "A new brain's default scope is the core ONLY — additional suites are enabled/installed exclusively on explicit operator request. The allowlist covers self-setup and self-analysis (core scripts/helpers, git reads, committing, plugin checks) and the everyday collaboration path: push (also `git -C <repo>`, the form working rule #8 prescribes for a neighbour repo), pull requests and issues. A push used to stay ask: measured 2026-10-16 on a collaborator's brain, every commit and push raised a dialog the human did not understand, and the AI read push as 'needs the operator' — the merge and publish gates (mechanism-guard, operator-only list) carry the real limits, not a permission dialog. Kept asking: settings edits, and a push that names `main` (a bare `git push` matches nothing here and is allowed — an instance whose ordered main push is a named form puts that form under its own allow). `gh pr merge` has no rule on purpose: the classifier and mechanism-guard decide merges. Denied: force pushes (`--force`, `-f`, `+ref`) and branch deletes with `--delete`. A delete spelled `:ref` has NO rule here: a pattern ending in `:*` is read as the legacy prefix form (`Bash(git push * :*)` would be a prefix match, not a glob), so it cannot be written safely; that spelling stays a known gap. `gh issue *` includes `gh issue delete` — a decision, not an oversight. These are `Bash(...)` rules only: on Windows a `git push` through the PowerShell tool has no rule and reaches the classifier (a dialog in normal mode).",
    "allow": [
      "Bash(python3 core/scripts/*)",
      "Bash(core/scripts/handover-gate.sh)",
      "Bash(bash core/scripts/*)",
      "Bash(bash core/helpers/*)",
      "Bash(node core/helpers/*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * pull --ff-only*)",
      "Bash(git pull --ff-only*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr checkout*)",
      "Bash(gh pr close*)",
      "Bash(gh issue *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git submodule status*)",
      "Bash(git submodule update*)",
      "Bash(git --version)",
      "Bash(node --version)",
      "Bash(python3 --version)",
      "Bash(claude --version)",
      "Bash(claude doctor)",
      "Bash(claude plugin list*)",
      "Bash(claude plugin validate*)",
      "Edit(docs/**)",
      "Edit(src/**)",
      "Edit(scripts/**)",
      "Edit(config/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/rules/**)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.mcp.json)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git -C * push * main*)",
      "Bash(git -C * push * HEAD:main*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git -C * push * --delete*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(.claude-state/**)"
    ]
  },
  "env": {}
}
